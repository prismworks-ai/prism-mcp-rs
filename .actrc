# Act configuration for optimized local CI runs
# This configures act to work efficiently with caching

# Use BuildKit for better caching
--env DOCKER_BUILDKIT=1

# Reuse containers between runs for faster execution
--reuse

# Use the same image as GitHub Actions
--platform ubuntu-latest=catthehacker/ubuntu:act-latest

# Default to running push events
--eventpath .github/workflows/event.json

# Bind mount the cargo registry for caching dependencies
--bind $HOME/.cargo/registry:/github/home/.cargo/registry
--bind $HOME/.cargo/git:/github/home/.cargo/git

# Keep containers around for debugging if needed
# Comment this out if you want containers removed after runs
# --rm=false
