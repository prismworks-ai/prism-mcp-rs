# Act configuration for optimized local CI runs
# This configures act to work efficiently with caching

# Use BuildKit for better caching
--env DOCKER_BUILDKIT=1

# Reuse containers between runs for faster execution
--reuse

# Use the same image as GitHub Actions
--platform ubuntu-latest=catthehacker/ubuntu:act-latest

# Bind working directory to container instead of copying (faster)
--bind

# Verbose output for debugging
--verbose
