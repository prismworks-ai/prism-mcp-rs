# Minimal cargo-deny configuration

[licenses]
allow = [
    "MIT",
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Unicode-DFS-2016",
    "CC0-1.0",
]

private = { ignore = true }

[bans]
multiple-versions = "warn"

[advisories]
vulnerability = "warn"
unmaintained = "warn"
yanked = "warn"

[sources]
unknown-registry = "warn"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
